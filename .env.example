# Copy to .env and set strong values before docker compose / local run.
# Never commit .env

POSTGRES_DB=guclogistics
DB_URL=jdbc:postgresql://localhost:5432/guclogistics
DB_USER=guc
DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379

# Min 32 characters/bytes
JWT_SECRET=

# Base64-encoded 32-byte AES key. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

GUC_STORAGE_PATH=./data/uploads
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
